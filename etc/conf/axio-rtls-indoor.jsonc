// Axiovel indoor show configuration: MAVLink drones positioned by the
// RTLS-Link UWB system. Each Zephyr RTLS tag exposes the FC's MAVLink stream
// on UDP 14550 and learns its peer from the first inbound datagram. The local
// listener ports below are paired with unicast adapters to each tag because
// wired-to-wireless broadcast is blocked on the bench AP.
{
  "EXTENSIONS": {
    // Listen on all interfaces so Axio Control can connect from anywhere
    "http_server": {
      "host": ""
    },


    // RTLS-Link devices (anchors + tags) for the RTLS panel. A board's
    // address is its NET_PREFIX plus its sysid (the last octet); the boards
    // stream to this host's MGMT_HOST:MGMT_PORT, the default listen_port.
    "rtls": {
      "enabled": true,
      "devices": [
        "192.168.0.101",
        "192.168.0.102",
        "192.168.0.103",
        "192.168.0.104",
        "192.168.0.105",
        "192.168.0.106",
        "192.168.0.107",
        "192.168.0.108",
        "192.168.0.194",
        "192.168.0.197",
        "192.168.0.198",
        "192.168.0.200",
        "192.168.0.220",
        "192.168.0.221",
        "192.168.0.222",
        "192.168.0.223",
        "192.168.0.224",
        "192.168.0.225",
        "192.168.0.250"
      ]
    },
    // MAVLink-based drones via the RTLS-Link UART bridge
    "mavlink": {
      "enabled": true,
      "networks": {
        "mav": {
          "connections": [
            // The RTLS-Link tags bridge their flight controllers' MAVLink
            // to this host on UDP 14550 (matches the "rtls-link mavlink"
            // ufw allow rule on enp2s0); one shared listener on all
            // interfaces replaces the former per-drone localhost ports,
            // which never saw the board-network traffic.
            "udp-listen://:14550?broadcast_port=14555"
          ]
        }
      }
    },

    // Show music from this host's default audio output, in sync with the
    // show clock (needs libportaudio2, see ext/show_audio/README.md)
    "show_audio": {
      "enabled": true,
      "device": null,
      "offset_ms": 0,
      "arm_lead_s": 15
    },

    // The server schedules the start; "rc" selects the RC-switch start
    // (RC option 248). With "auto" and no start time set, the server
    // broadcasts a show schedule without a start (and a "clear start time"
    // START_CONFIG) at 1 Hz, which cancels an RC-switch countdown on the
    // drones.
    "show": {
      "default_start_method": "auto"
    }
  }
}
